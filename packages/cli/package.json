{
  "name": "@clean-ui/cli",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "clean-ui": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --tsconfig tsconfig.build.json",
    "test": "vitest run --root ../.. --project unit --dir packages/cli"
  },
  "dependencies": {
    "@clean-ui/adapter-react-css": "workspace:*",
    "@clean-ui/compiler": "workspace:*",
    "@clean-ui/schema": "workspace:*",
    "@clean-ui/validators": "workspace:*"
  }
}
